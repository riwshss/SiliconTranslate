{
  "name": "silk-translate",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "丝译 — 支持硅基流动、Google 翻译与 Chrome 内置本地模型的无痕网页翻译 Chrome 扩展",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "node e2e/run.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
