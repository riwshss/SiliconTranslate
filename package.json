{
  "name": "silk-translate",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "丝译 Silk Translate — Silk AI 云端翻译 · 双语对照 · 划词翻译，中英文界面",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "node e2e/run.mjs",
    "package": "node scripts/package.mjs",
    "regression": "node scripts/regression.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
