{
  "manifest_version": 3,
  "name": "丝译 Silk Translate",
  "short_name": "丝译",
  "version": "2.2.1",
  "description": "无痕网页翻译 · Seamless web page translation. Silk AI 云端翻译，可选 Claude Haiku 5.5 / GPT-6 Sol / Gemini 3.8 Flash；双语对照，划词翻译。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "丝译 Silk Translate",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
